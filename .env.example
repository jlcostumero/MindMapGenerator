# =================================================================
# MindMapGenerator - Configuración de Entorno (.env)
# =================================================================

# 1. Motor de Inteligencia Artificial (DeepSeek o OpenAI compatible)
DEEPSEEK_API_KEY=tu_deepseek_api_key_aqui
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# 2. Seguridad de Sesión Flask
SECRET_KEY=genera_una_clave_aleatoria_segura_aqui

# 3. Base de Datos / Persistencia (Opcional)
# Si no configuras MONGO_URI, se usará automáticamente almacenamiento local en JSON (data/)
# MONGO_URI=mongodb://localhost:27017
# MONGO_DB=maps

# 4. Proxy opcional para transcripción de YouTube (dejar vacío si no usas proxy)
YOUTUBE_PROXY=

# 5. Puerto y Host
HOST=0.0.0.0
PORT=1000
